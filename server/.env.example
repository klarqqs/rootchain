# Railway PostgreSQL (required)
# Matches docker-compose.yml postgres service
DATABASE_URL=postgresql://rootchain:rootchain@localhost:5433/rootchain

# JWT (required — min 32 characters each; dev placeholders below)
JWT_ACCESS_SECRET=dev-only-rootchain-jwt-access-secret-32c
JWT_REFRESH_SECRET=dev-only-rootchain-jwt-refresh-secret-32c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
# Comma-separated; in development LAN IPs (e.g. :5174) are also allowed
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# Stellar — testnet | mainnet (single flip for entire platform)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
STELLAR_HORIZON_URL_MAINNET=https://horizon.stellar.org
STELLAR_PASSPHRASE_TESTNET=Test SDF Network ; September 2015
STELLAR_PASSPHRASE_MAINNET=Public Global Stellar Network ; September 2015
USDC_ISSUER_TESTNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
PLATFORM_ESCROW_TESTNET=
PLATFORM_ESCROW_MAINNET=

# Redis (optional — cache + multi-instance SSE fan-out)
# Leave unset for local dev unless Redis is running:
#   docker compose up -d redis
# REDIS_URL=redis://localhost:6379

# Email notifications (log provider in dev)
EMAIL_ENABLED=false
EMAIL_PROVIDER=log

# Optional Pusher (future — SSE is default realtime transport)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=

# Seed admin (optional — used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@rootchain.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
