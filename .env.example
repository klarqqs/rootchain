# ════════════════════════════════════════════════════════════════════════
# ROOTCHAIN — Stellar Mainnet configuration
# Copy to .env and adjust. Never commit secrets or funded key material.
# ════════════════════════════════════════════════════════════════════════

# Stellar Mainnet (default)
VITE_STELLAR_NETWORK=PUBLIC
VITE_MAINNET_ROUTING_ENABLED=true
VITE_STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
VITE_STELLAR_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Circle USDC on Stellar mainnet
VITE_USDC_ASSET_CODE_MAINNET=USDC
VITE_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Platform escrow treasury (mainnet G-address that receives USDC investments)
VITE_PLATFORM_ESCROW_MAINNET=

# Soroban mainnet RPC (optional)
VITE_STELLAR_SOROBAN_RPC_PUBLIC=https://soroban-mainnet.stellar.org

# Require real wallet for all settlement (recommended for production)
VITE_REQUIRE_REAL_WALLET=true

# ─── Legacy testnet (opt-in only — set VITE_MAINNET_ROUTING_ENABLED=false) ───
# VITE_STELLAR_NETWORK=TESTNET
# VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# VITE_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# VITE_PLATFORM_ESCROW=GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGZEF5Q6EWRH5KHMU4HYL

# Polling interval for live Horizon balance refresh (ms, default 12 000).
VITE_BALANCE_POLL_MS=12000

# Polling interval for live transaction history fetch (ms, default 20 000).
VITE_TX_POLL_MS=20000

# Minimum XLM base reserve reference (informational UI).
VITE_STELLAR_MIN_BALANCE=1.5

# ─── Railway API (recommended backend) ───────────────────────────────────────
# When set, auth + marketplace use PostgreSQL via server/ (JWT).
VITE_API_URL=http://localhost:3001/api/v1

# API database + JWT live in server/.env (not this file). Copy and edit:
#   cp server/.env.example server/.env
# Local Postgres (docker compose up -d postgres):
#   DATABASE_URL=postgresql://rootchain:rootchain@localhost:5433/rootchain

# Optional legacy admin token (prefer API admin role)
# VITE_ADMIN_TOKEN=

# ─── Supabase (legacy — optional if VITE_API_URL is set) ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_AUTH=true

# ─── App environment ─────────────────────────────────────────────────────────
VITE_APP_ENV=production
VITE_DEMO_MODE=false
VITE_SHOWCASE_MODE=false

# Mock backend latency (dev only — does not affect on-chain balances)
VITE_MOCK_LATENCY_MS=600
VITE_MOCK_ERROR_RATE=0
VITE_TX_CONFIRM_DELAY_MS=2200

# ─── ROOTCHAIN Assistant (optional) ───────────────────────────────────────────
VITE_AI_CHAT_URL=
VITE_AI_CHAT_PUBLIC_TOKEN=
