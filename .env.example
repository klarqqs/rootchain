# ════════════════════════════════════════════════════════════════════════
# ROOTCHAIN — Phase 2 environment configuration (TESTNET ONLY)
# Copy to .env and adjust as needed. Never use mainnet values here.
# ════════════════════════════════════════════════════════════════════════

# Network — must be TESTNET in Phase 2.
VITE_STELLAR_NETWORK=TESTNET
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban (smart-contract) RPC — used in later phases.
VITE_STELLAR_SOROBAN_RPC=https://soroban-testnet.stellar.org

# USDC asset on testnet (Circle's testnet issuer is non-standard;
# this is a placeholder issuer commonly used in Stellar tutorials).
# Override with your own testnet USDC issuer if needed.
VITE_USDC_ASSET_CODE=USDC
VITE_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# RC-SHARES asset (placeholder for the harvest-share token).
VITE_RC_ASSET_CODE=RCSHARE
VITE_RC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Mock backend — toggle simulated network conditions for development.
VITE_MOCK_LATENCY_MS=600
VITE_MOCK_ERROR_RATE=0
VITE_TX_CONFIRM_DELAY_MS=2200

# ─── Phase 3 Supabase — real backend persistence ──────────────────────────────
# Obtain from your Supabase project dashboard → Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Requires valid Supabase client + anon key · enables login + route guards across dashboards.
VITE_SUPABASE_AUTH=false

# OAuth (Google): add Authorized redirect URI = your SPA origin (e.g. https://localhost:5173/).
# ─── Phase 3 Stellar testnet platform accounts ────────────────────────────────
# Escrow address that receives investment payments on testnet.
# Fund it via friendbot: https://friendbot.stellar.org/?addr=<address>
VITE_PLATFORM_ESCROW=GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGZEF5Q6EWRH5KHMU4HYL

# Exchange rate used on testnet (1 USDC = N XLM).
# On mainnet this will come from a price oracle.
VITE_USDC_XLM_RATE=8.47

# Minimum XLM balance required for an account to transact (Stellar reserve).
VITE_STELLAR_MIN_BALANCE=1.5

# Polling interval for live Horizon balance refresh (ms, default 12 000 = 12s).
VITE_BALANCE_POLL_MS=12000

# Polling interval for live transaction history fetch (ms, default 20 000).
VITE_TX_POLL_MS=20000

# ─── Phase 5 — Launch / ops flags (PUBLIC — never put secrets besides admin gate token) ─
# development | staging | production — drives banners and telemetry defaults.
VITE_APP_ENV=development
# Sandbox copy + demo-environment banner when true (still testnet).
VITE_DEMO_MODE=false
# Pitch / showcase mode — extra demo framing only.
VITE_SHOWCASE_MODE=false
# Lightweight operator gate for the Admin Console UI (migrate to SSO in production).
# Leave empty locally to hide admin tools unless you explicitly set a throwaway demo token.

# ─── ROOTCHAIN Assistant (optional LLM gateway) ─────────────────────────────────
# Point to your Supabase Edge Function / Cloudflare Worker that injects OPENAI_SECRET server-side.
# Request JSON: { messages: [{role,content}], context: {...} }
# Response JSON: { content: string } OR { reply: string } OR { message: { content } }
VITE_AI_CHAT_URL=
# Optional public token accepted by YOUR gateway — not an OpenAI key.
VITE_AI_CHAT_PUBLIC_TOKEN=
